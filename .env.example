# Copy to .env and fill in what you use. Lines starting with # are ignored.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_HOST=http://localhost:11434
# OPENAI_BASE_URL=https://api.openai.com/v1      # or http://localhost:1234/v1 for LM Studio, etc.
# BREACHMARK_DB=breachmark.db
# BREACHMARK_PORT=8000
# BREACHMARK_HOST=127.0.0.1                        # 0.0.0.0 to reach it from other machines (then set ALLOWED_HOSTS)
# BREACHMARK_ALLOWED_HOSTS=myhost.local,192.168.1.10
