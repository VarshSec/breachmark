  NS_ASSERTION(contElement, ""nsIScriptElement isn't nsIContent"");

  nsAutoString forAttr, eventAttr;
  if (!contElement->GetAttr(kNameSpaceID_None, nsGkAtoms::_for, forAttr) ||
