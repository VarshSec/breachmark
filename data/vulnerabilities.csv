    if (ILLEGAL_RANGE(c)) {
        /* U+0080/U+0100 - U+FFFF data lost. */
        static const size_t MSG_BUF_SIZE = 64;
        char msg[MSG_BUF_SIZE];
        JS_snprintf(msg, MSG_BUF_SIZE, ""jschar out of char range; high bits of data lost: 0x%x"", c);
        NS_WARNING(msg);
        return false;
    }

    return true;
}
