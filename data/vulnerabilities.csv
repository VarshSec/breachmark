static always_inline int _raw_read_trylock(raw_rwlock_t *rw)
{
    unsigned long tmp, tmp2 = 1;

    __asm__ __volatile__(
""1: ldrex   %0, [%2]\n""
""   adds    %0, %0, #1\n""
""   strexpl %1, %0, [%2]\n""
    : ""=&r"" (tmp), ""+r"" (tmp2)
    : ""r"" (&rw->lock)
    : ""cc"");

    smp_mb();
    return tmp2 == 0;
}
