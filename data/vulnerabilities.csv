                     cp64.read ? ""mrrc"" : ""mcrr"",
                     cp64.op1, cp64.reg1, cp64.reg2, cp64.crm, regs->pc);
            gdprintk(XENLOG_ERR, ""unhandled 64-bit CP15 access %#x\n"",
