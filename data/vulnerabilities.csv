             * replace_grant_host_mapping() so nothing further to do
             */
            goto act_release_out;
        }

        if ( !is_iomem_page(_mfn(op->frame)) )
        {
            if ( gnttab_host_mapping_get_page_type(op, ld, rd) )
                put_page_type(pg);
            put_page(pg);
        }
