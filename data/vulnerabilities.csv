  // pixels from the current position
  if (currentCSSPixels.x == aScrollPosition.x) {
    pt.x = current.x;
    range.x = pt.x;
    range.width = 0;
  }

  }
  ScrollTo(pt, nsIScrollableFrame::INSTANT, &range);
}

