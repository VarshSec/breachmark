bool
nsDeque::GrowCapacity()
{
  int32_t theNewSize = mCapacity << 2;
  NS_ASSERTION(theNewSize > mCapacity, ""Overflow"");
  if (theNewSize <= mCapacity) {
    return false;
  }
  void** temp = (void**)malloc(theNewSize * sizeof(void*));
  if (!temp) {
    return false;
