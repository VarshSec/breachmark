                    corrvalue = this.innerDiv.offsetWidth - this.outerDiv.offsetWidth;
                }
                this.dirsign = 1;
                this.startAt = (this._behavior == 'alternate') ? (this.innerDiv.offsetWidth - corrvalue) : 0;
                this.stopAt  = this.outerDiv.offsetWidth + 
