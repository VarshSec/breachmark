                     flags, id, ldomid, !readonly);
        }
    }
    else
    {
        if ( unlikely(flags & GTF_readonly) )
        {
            gnttab_clear_flag(_GTF_writing, status);
            PIN_FAIL(done, GNTST_general_error,
                     ""Unstable grant readonly flag\n"");
        }
    }

done:
    return rc;
}
