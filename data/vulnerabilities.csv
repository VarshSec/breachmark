#ifdef CONFIG_X86_64
		, ""rax"", ""rbx"", ""rdi"", ""rsi""
		, ""r8"", ""r9"", ""r10"", ""r11"", ""r12"", ""r13"", ""r14"", ""r15""
#else
		, ""eax"", ""ebx"", ""edi"", ""esi""
#endif
	      );

