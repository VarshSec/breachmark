inline bool
NS_IsAboutBlank(nsIURI *uri)
{
    // GetSpec can be expensive for some URIs, so check the scheme first.
    bool isAbout = false;
    if (NS_FAILED(uri->SchemeIs(""about"", &isAbout)) || !isAbout) {
        return false;
    }

    nsCAutoString str;
    uri->GetSpec(str);
    return str.EqualsLiteral(""about:blank"");
}

