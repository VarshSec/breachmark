    uint32_t newTotalLen = mLength - aCutLength + aNewLength;
    if (aCutStart == mLength && Capacity() > newTotalLen) {
      mFlags &= ~F_VOIDED;
      mData[newTotalLen] = char_type(0);
      mLength = newTotalLen;
      return true;
    }
