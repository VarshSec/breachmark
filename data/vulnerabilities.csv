    nsWeakFrame weakFrame(this);
    // should aMaySnap be true here?
    SetCurrentThumbPosition(scrollbar, pos - thumbLength/2, false, false, false);
    NS_ENSURE_TRUE(weakFrame.IsAlive(), NS_OK);

