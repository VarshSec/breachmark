  MOZ_LOG(sBMPLog, LogLevel::Debug,
          (""BMP: bihsize=%u, %d x %d, bpp=%u, compression=%u, colors=%u\n"",
          mH.mBIHSize, mH.mWidth, mH.mHeight, uint32_t(mH.mBpp),
          mH.mCompression, mH.mNumColors));

