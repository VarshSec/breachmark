# Android NDK r5c, used on the builders at the time of this writing, doesn't
# have the headers we need for IPv6
if CONFIG['OS_TARGET'] != 'Android':
    DEFINES['INET6'] = 1

if CONFIG['OS_TARGET'] == 'WINNT':
    DEFINES['__Userspace_os_Windows'] = 1
