const PC_SESSION_CID = Components.ID(""{1775081b-b62d-4954-8ffe-a067bbf508a7}"");
const PC_MANAGER_CID = Components.ID(""{7293e901-2be3-4c02-b4bd-cbef6fc24f78}"");
