    }
    break;

    case NS_TOUCH_END:
    case NS_MOUSE_BUTTON_UP:
      if (aEvent->message == NS_TOUCH_END ||
          static_cast<nsMouseEvent*>(aEvent)->button == nsMouseEvent::eLeftButton ||
          (static_cast<nsMouseEvent*>(aEvent)->button == nsMouseEvent::eMiddleButton &&
           gMiddlePref)) {
