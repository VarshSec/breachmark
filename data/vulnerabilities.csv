function test_upload_file() {
  dump(""*** test_upload_file\n"");

  var file = getFile(""XpcomLib"");  // file to upload
  var dest = getFile(""TmpD"");      // file upload destination
  dest.append(""junk.dat"");
  dest.createUnique(dest.NORMAL_FILE_TYPE, 0600);

