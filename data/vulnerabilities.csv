    pref_string[prefs.PREF_INT] = ""INT"";
    pref_string[prefs.PREF_BOOL] = ""BOOL"";
    pref_string[prefs.PREF_STRING] = ""CHAR"";

    var pendingActions = [];
    var cleanupActions = [];

    for (var action in inPrefs) { /* set|clear */
      for (var idx in inPrefs[action]) {
