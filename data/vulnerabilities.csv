                uint32_t generation = expandoAndGeneration->generation;
                JitSpew(JitSpew_BaselineIC,
                        ""  Updating existing stub with generation, old value: %i, ""
                        ""new value: %i"", updateStub->generation(),
                        generation);
                updateStub->setGeneration(generation);
                return true;
            }
