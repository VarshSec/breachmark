let FocusSyncHandler = {
  init: function() {
    sendAsyncMessage(""SetSyncHandler"", {}, {handler: this});
  },

  getFocusedElementAndWindow: function() {
    let fm = Cc[""@mozilla.org/focus-manager;1""].getService(Ci.nsIFocusManager);

    let focusedWindow = {};
