		""mov %%cr2, %%"" _ASM_DX "" \n\t""
		""cmp %%"" _ASM_AX "", %%"" _ASM_DX "" \n\t""
		""je 2f \n\t""
		""mov %%"" _ASM_AX"", %%cr2 \n\t""
		""2: \n\t""
