{
  if (!strcmp(aTopic, BLUETOOTH_SCO_STATUS_CHANGED)) {
    if (NS_strlen(aData) > 0) {
      String8 cmd;
      cmd.appendFormat(""bt_samplerate=%d"", kBtSampleRate);
