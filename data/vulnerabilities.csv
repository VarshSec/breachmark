            this.startNewDirection = true;
          }
          this._direction = aValue;
        ]]>
        </body>
      </method>

      <method name=""_set_loop"">
        <parameter name=""aValue""/>
        <body>
          <![CDATA[
          var aValue = parseInt(aValue);
          if (aValue == 0) {
            return;
          }
          if (isNaN(aValue) || aValue <= -1) {
            aValue = -1;
          }
          this._loop = aValue;
